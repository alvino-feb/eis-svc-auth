  BOX
  PACK
  KG
  GRAM
  LTR
  ML
  HOUR
  DAY
}

enum WarehouseTransactionDirection {
  IN
  OUT
}

enum WarehouseTransactionCategory {
  SALES
  PURCHASE
  WAREHOUSE
  SHIPMENT
  OTHER
}

enum OrderStatus {
