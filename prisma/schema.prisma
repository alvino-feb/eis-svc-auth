  CASH_OUT
  ADJUSTMENT
}

enum EmployeeIdentifierType {
  NIK
  PID
}

enum EmployeeGender {
  MALE
  FEMALE
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
}

enum EmploymentStatus {
  ACTIVE
  PROBATION
  INACTIVE
  RESIGNED
  TERMINATED
  RETIRED
}

enum UserType {
